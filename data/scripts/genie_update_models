#!/usr/bin/env bash

set -e

CONFIG_FILE=~/.config/opencode/opencode.json

mkdir -p $(dirname $CONFIG_FILE)

curl -s http://localhost:11434/api/tags | jq '{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "opencode"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": (
        [ .models[] | {
            key: .model,
            value: {
              name: (
                (.model | sub("^(?:[^/]+/){2}"; "") | sub("-GGUF"; "")) +
                " (" + ((.size / 1000000000 | floor) | tostring) + " GB)"
              )
            }
          }
        ] | from_entries
      )
    }
  }
}' > $CONFIG_FILE
echo "🧞‍♂️ Wish granted: models updated in OpenCode"
jq '.provider.ollama.models[].name' $CONFIG_FILE
echo "Choose the default model with genie_choose_default_model"
